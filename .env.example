# Copy to .env (next to this file). Used by deploy/docker-compose.yml and by `uvicorn` if you export it locally.
DOMAIN=example.com                 # site is served at https://elder.$DOMAIN
OPENROUTER_API_KEY=                # empty = template text, labelled "AI text unavailable"
OPENROUTER_MODEL=google/gemini-2.5-flash
MAX_LLM_USD_PER_DAY=2
VLM_SECOND_OPINION=                # 1 = the vision model reviews every stretch of footage with a person (postures, activity) and
                                   #     checks each fall before it is pushed (only a clear NO stops it). Sends 768 px frames to
                                   #     the cloud: ~$0.4-1.5 a day for 5 cameras with Flash; capped by MAX_LLM_USD_PER_DAY
DEMO_PASSCODE=                     # set to require a passcode for uploads
RETENTION_HOURS=24
UPLOADS_PER_HOUR=5
MAX_UPLOAD_MB=100
# Live mode: phone alerts + daily report. Locally: uvicorn app.main:app --env-file .env --host 0.0.0.0 --port 8000
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_CHAT_ID=                 # from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot
RESIDENT_NAME=Resident
REPORT_AT=21:00
