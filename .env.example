# Copy to .env (next to this file). Used by deploy/docker-compose.yml and by `uvicorn` if you export it locally.
DOMAIN=example.com                 # site is served at https://elder.$DOMAIN
OPENROUTER_API_KEY=                # empty = template text, labelled "AI text unavailable"
OPENROUTER_MODEL=google/gemini-2.5-flash
MAX_LLM_USD_PER_DAY=2
DEMO_PASSCODE=                     # set to require a passcode for uploads
RETENTION_HOURS=24
UPLOADS_PER_HOUR=5
MAX_UPLOAD_MB=100
